<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Submission Summary', css: ['summary.css'] }) %>
</head>
<body>
<%- include('partials/nav') %>

  <h1>Submission Summary</h1>

  <div id="pageContent" class="summary-wrapper">
    <div class="downloadRow">
      <a id="downloadPdfBtn" href="/api/pdf" download="submission-summary.pdf">Download PDF</a>
    </div>

    <section class="entry-card">
      <div class="entry-header">
        <h3>Personal Info</h3>
      </div>
      <div id="personalInfoGrid" class="info-grid"></div>
    </section>

    <section class="entry-card">
      <div class="entry-header">
        <h3>Spouse &amp; Other Member Info</h3>
      </div>
      <div id="somGrid" class="info-grid"></div>
      <div id="somOtherAdultsSections"></div>
    </section>

    <section id="employmentSections"></section>

    <section id="incomeCalculationsSections"></section>

    <section id="assetsSections"></section>

    <section id="liabilitiesSections"></section>

    <section class="entry-card">
      <div class="entry-header">
        <h3>Questionnaire</h3>
      </div>
      <div id="questionnaireGrid" class="info-grid"></div>
    </section>

    <section class="entry-card">
      <div class="entry-header">
        <h3>Income</h3>
      </div>
      <div id="incomeGrid" class="info-grid"></div>
    </section>

    <section id="expensesSections"></section>
  </div>

<%- include('partials/scripts', { pageScript: 'summary.js', gate: true, extraScripts: ['field-labels.browser.js'] }) %>
</body>
</html>
